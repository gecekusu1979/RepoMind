{
    "manifest_version": 3,
    "name": "RepoMind — GitHub Analyzer",
    "version": "1.1.0",
    "description": "Analyze GitHub repositories with zero configuration directly from the browser.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "*://github.com/*/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icons/icon.svg"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://github.com/*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "48": "icons/icon.svg"
    }
}